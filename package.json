{
  "name": "receipt-assistant-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/app/server.ts",
